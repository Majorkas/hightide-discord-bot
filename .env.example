# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token

# Database URL (defaults to local SQLite if not set)
DATABASE_URL=sqlite:///./hightide.db

# Event timezone (IANA timezone name, defaults to Australia/Perth)
DEFAULT_TIMEZONE=Australia/Perth

# Optional: Discord server ID for faster command sync in development
GUILD_ID=

# --- Decision-tracking bot (optional; omit to run only the events bot) ---
# Token for the SECOND Discord application (decision bot). Its app must have the
# Message Content intent enabled in the Developer Portal.
DECISION_BOT_TOKEN=
# OpenAI key for AI decision detection (GPT-4o-mini)
OPENAI_API_KEY=
# Trello API credentials (https://trello.com/power-ups/admin -> API key + token)
TRELLO_API_KEY=
TRELLO_API_TOKEN=
