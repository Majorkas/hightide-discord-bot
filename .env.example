# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token

# Database URL (defaults to local SQLite if not set)
DATABASE_URL=sqlite:///./hightide.db

# Event timezone (IANA timezone name, defaults to Australia/Perth)
DEFAULT_TIMEZONE=Australia/Perth

# Optional: Discord server ID for faster command sync in development
GUILD_ID=
